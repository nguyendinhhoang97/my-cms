# =============================================================================
# my-cms — Environment Variables
# Copy to `.dev.vars` (local Wrangler) or set in Cloudflare Dashboard.
# =============================================================================

# --- Cloudflare D1 ---
# database_id lấy từ: npx wrangler d1 create my-cms-db
# Cấu hình binding "DB" trong wrangler.toml — không cần env var riêng trên Workers.

# --- Cloudflare R2 (media upload) ---
R2_ACCESS_KEY_ID=your_access_key_id
R2_SECRET_ACCESS_KEY=your_secret_access_key
R2_BUCKET_NAME=my-cms-media
R2_PUBLIC_URL=https://media.example.com
R2_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com

# --- Email notifications (optional — Resend) ---
EMAIL_API_KEY=
EMAIL_FROM=noreply@yourdomain.com

# --- Local scripts (create-admin / seed) ---
# ADMIN_USERNAME=admin
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=changeme123

# --- Production Cloudflare Dashboard (Pages/Workers Secrets) ---
# Set via: npx wrangler secret put R2_ACCESS_KEY_ID
#
# Recommended secrets:
#   R2_ACCESS_KEY_ID
#   R2_SECRET_ACCESS_KEY
#   R2_BUCKET_NAME
#   R2_PUBLIC_URL
#   R2_ENDPOINT
#   EMAIL_API_KEY        (optional)
#   EMAIL_FROM           (optional)

# Note: Astro + @astrojs/cloudflare injects D1 binding "DB" from wrangler.toml.
# SESSION KV binding is auto-configured by the adapter for sessions.
