---
/**
 * Breadcrumb navigation (visual only — JSON-LD qua JsonLd.astro).
 */
export interface BreadcrumbItem {
	label: string;
	href?: string;
}

interface Props {
	items: BreadcrumbItem[];
}

const { items } = Astro.props;
---

<nav aria-label="Breadcrumb" class="mb-6 text-sm opacity-70">
	<ol class="flex flex-wrap items-center gap-1">
		{
			items.map((item, i) => (
				<li class="flex items-center gap-1">
					{i > 0 && <span aria-hidden="true">/</span>}
					{item.href ? (
						<a href={item.href} class="hover:text-indigo-500 hover:underline">
							{item.label}
						</a>
					) : (
						<span class="font-medium opacity-100">{item.label}</span>
					)}
				</li>
			))
		}
	</ol>
</nav>
