---
/**
 * Form đăng ký newsletter — footer blog.
 */
interface Props {
	csrfToken: string;
}

const { csrfToken } = Astro.props;
---

<div class="newsletter-form-root w-full max-w-md">
	<h3 class="text-sm font-semibold">Đăng ký nhận tin</h3>
	<p class="mt-1 text-xs opacity-60">Nhận bài viết mới qua email.</p>
	<form id="newsletter-form" class="mt-3 flex gap-2" novalidate>
		<input
			type="email"
			id="newsletter-email"
			name="email"
			required
			placeholder="email@example.com"
			maxlength="255"
			class="min-w-0 flex-1 rounded-lg border border-slate-300 bg-transparent px-3 py-2 text-sm dark:border-slate-700"
		/>
		<button
			type="submit"
			id="newsletter-submit"
			class="shrink-0 rounded-lg bg-indigo-600 px-4 py-2 text-sm font-semibold text-white hover:bg-indigo-500 disabled:opacity-50"
		>
			Đăng ký
		</button>
	</form>
	<p id="newsletter-message" class="mt-2 hidden text-xs" role="alert"></p>
</div>

<script define:vars={{ csrfToken }}>
	const form = document.getElementById('newsletter-form');
	const msg = document.getElementById('newsletter-message');
	const btn = document.getElementById('newsletter-submit') as HTMLButtonElement | null;

	form?.addEventListener('submit', async (e) => {
		e.preventDefault();
		if (!btn || !form) return;

		const email = (document.getElementById('newsletter-email') as HTMLInputElement)?.value.trim();
		if (!email) return;

		btn.disabled = true;
		msg?.classList.add('hidden');

		try {
			const res = await fetch('/api/newsletter/subscribe', {
				method: 'POST',
				headers: {
					'Content-Type': 'application/json',
					Accept: 'application/json',
					'X-CSRF-Token': csrfToken,
				},
				credentials: 'same-origin',
				body: JSON.stringify({ email, csrf_token: csrfToken }),
			});
			const data = await res.json().catch(() => ({}));
			if (msg) {
				msg.textContent = data.data?.message ?? data.error ?? (res.ok ? 'Thành công!' : 'Lỗi.');
				msg.className = res.ok
					? 'mt-2 text-xs text-emerald-600 dark:text-emerald-400'
					: 'mt-2 text-xs text-red-500';
				msg.classList.remove('hidden');
			}
			if (res.ok) form.reset();
		} catch {
			if (msg) {
				msg.textContent = 'Lỗi kết nối.';
				msg.className = 'mt-2 text-xs text-red-500';
				msg.classList.remove('hidden');
			}
		} finally {
			btn.disabled = false;
		}
	});
</script>
