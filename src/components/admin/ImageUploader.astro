---
/**
 * Upload ảnh lên R2 — drag-drop, preview, progress, copy URL, media library.
 */
interface Props {
	/** ID input nhận URL (vd: featured_image) */
	targetInputId?: string;
	/** URL ảnh hiện tại */
	initialUrl?: string;
	/** compact cho sidebar PostForm */
	compact?: boolean;
}

const { targetInputId = '', initialUrl = '', compact = false } = Astro.props;
const hasInitial = Boolean(initialUrl);
---

<div
	class:list={['image-uploader-root', compact && 'image-uploader--compact']}
	data-image-uploader
>
	<div
		data-dropzone
		class="flex cursor-pointer flex-col items-center justify-center rounded-xl border-2 border-dashed border-slate-700 bg-slate-900/40 px-4 py-8 transition hover:border-slate-600"
	>
		<input
			type="file"
			data-file-input
			accept="image/jpeg,image/png,image/webp,image/gif"
			class="hidden"
		/>
		<svg
			class="mb-3 h-10 w-10 text-slate-500"
			fill="none"
			stroke="currentColor"
			viewBox="0 0 24 24"
			aria-hidden="true"
		>
			<path
				stroke-linecap="round"
				stroke-linejoin="round"
				stroke-width="1.5"
				d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"
			></path>
		</svg>
		<p class="text-sm font-medium text-slate-300">Kéo thả ảnh hoặc click để chọn</p>
		<p class="mt-1 text-xs text-slate-500">JPEG, PNG, WebP, GIF — tối đa 5MB</p>
	</div>

	<div data-progress-wrap class="mt-3 hidden">
		<div class="h-1.5 overflow-hidden rounded-full bg-slate-800">
			<div
				data-upload-progress
				class="h-full bg-indigo-500 transition-all duration-200"
				style="width: 0%"
			>
			</div>
		</div>
	</div>

	<div class="mt-4">
		<label for="alt-text-input" class="mb-1 block text-xs font-medium text-slate-400">
			Alt text <span class="text-slate-600">(tự sinh từ tên file)</span>
		</label>
		<input
			id="alt-text-input"
			type="text"
			data-alt-input
			placeholder="Mô tả ảnh cho SEO & accessibility"
			maxlength="500"
			class="w-full rounded-lg border border-slate-700 bg-slate-800/60 px-3 py-2 text-sm text-white outline-none focus:border-indigo-500"
		/>
	</div>

	<div data-preview-empty class:list={['mt-4 text-center text-sm text-slate-500', hasInitial && 'hidden']}>
		Chưa có ảnh
	</div>

	<div data-preview class:list={['mt-4', !hasInitial && 'hidden']}>
		<img
			data-preview-img
			src={initialUrl}
			alt=""
			class="max-h-48 w-full rounded-lg object-contain bg-slate-900"
		/>
	</div>

	<input type="hidden" data-result-url value={initialUrl} />
	<input type="hidden" data-result-key value="" />

	<div class="mt-3 flex flex-wrap gap-2">
		<button
			type="button"
			data-copy-url
			class="rounded-lg border border-slate-700 px-3 py-1.5 text-xs text-slate-300 hover:bg-slate-800"
		>
			Copy URL
		</button>
		<button
			type="button"
			data-open-library
			class="rounded-lg border border-slate-700 px-3 py-1.5 text-xs text-slate-300 hover:bg-slate-800"
		>
			Thư viện
		</button>
		<button
			type="button"
			data-remove
			class="rounded-lg border border-red-500/30 px-3 py-1.5 text-xs text-red-400 hover:bg-red-500/10"
		>
			Xóa
		</button>
	</div>

	<p data-status class="mt-2 min-h-[1.25rem] text-sm"></p>
</div>

<script define:vars={{ targetInputId, initialUrl }}>
	import { initImageUploader } from '../../scripts/image-uploader';
	initImageUploader({
		targetInputId: targetInputId || undefined,
		initialUrl: initialUrl || undefined,
		mode: targetInputId ? 'picker' : 'standalone',
	});
</script>
