---
/**
 * Form tạo/sửa bài — tái sử dụng create/edit.
 * Logic: src/scripts/post-form.ts (EasyMDE, live preview, fetch).
 */
import ImageUploader from './ImageUploader.astro';
import type { PostDTO } from '../../lib/db/posts';
import { escapeHtml } from '../../lib/security';

interface CategoryOption {
	id: number;
	name: string;
	slug: string;
}

interface TagOption {
	id: number;
	name: string;
	slug: string;
}

interface Props {
	mode: 'create' | 'edit';
	categories: CategoryOption[];
	tags: TagOption[];
	post?: PostDTO | null;
}

const { mode, categories, tags, post = null } = Astro.props;

const isEdit = mode === 'edit' && post;
const postId = post?.id ?? 0;

const initial = {
	title: post?.title ?? '',
	slug: post?.slug ?? '',
	content: post?.content ?? '',
	excerpt: post?.excerpt ?? '',
	featuredImage: post?.featuredImage ?? '',
	status: post?.status ?? 'draft',
	categoryIds: post?.categoryIds ?? [],
	tagIds: post?.tagIds ?? [],
};
---

<div class="post-form-root">
	<form id="post-form" class="space-y-6" novalidate>
		<div class="grid gap-6 xl:grid-cols-3">
			<div class="space-y-6 xl:col-span-2">
				<div class="grid gap-4 sm:grid-cols-2">
					<div class="sm:col-span-2">
						<label for="title" class="mb-1.5 block text-sm font-medium text-slate-300">
							Tiêu đề
						</label>
						<input
							id="title"
							name="title"
							type="text"
							required
							maxlength="500"
							value={initial.title}
							class="w-full rounded-lg border border-slate-700 bg-slate-800/60 px-4 py-2.5 text-white outline-none focus:border-indigo-500 focus:ring-2 focus:ring-indigo-500/30"
						/>
					</div>
					<div class="sm:col-span-2">
						<label for="slug" class="mb-1.5 block text-sm font-medium text-slate-300">
							Slug <span class="text-slate-500">(tự sinh)</span>
						</label>
						<input
							id="slug"
							name="slug"
							type="text"
							maxlength="200"
							value={initial.slug}
							class="w-full rounded-lg border border-slate-700 bg-slate-800/60 px-4 py-2.5 font-mono text-sm text-white outline-none focus:border-indigo-500 focus:ring-2 focus:ring-indigo-500/30"
						/>
					</div>
				</div>

				<div>
					<label for="content" class="mb-1.5 block text-sm font-medium text-slate-300">
						Nội dung (Markdown)
					</label>
					<textarea
						id="content"
						name="content"
						rows="12"
						class="w-full rounded-lg border border-slate-700 bg-slate-800/60 text-white"
					>{initial.content}</textarea>
				</div>

				<!-- Live preview -->
				<div class="rounded-xl border border-slate-800 bg-slate-900/50">
					<div
						class="flex items-center justify-between border-b border-slate-800 px-4 py-2.5"
					>
						<h3 class="text-sm font-semibold text-slate-200">Live preview</h3>
						<span class="text-xs text-slate-500">Cập nhật khi gõ</span>
					</div>
					<div
						id="live-preview"
						class="markdown-preview min-h-[200px] max-h-[480px] overflow-y-auto p-4 text-sm"
					>
						<p class="text-slate-500">Nhập nội dung để xem trước...</p>
					</div>
				</div>

				<div>
					<label for="excerpt" class="mb-1.5 block text-sm font-medium text-slate-300">
						Tóm tắt
					</label>
					<textarea
						id="excerpt"
						name="excerpt"
						rows="3"
						maxlength="2000"
						class="w-full rounded-lg border border-slate-700 bg-slate-800/60 px-4 py-2.5 text-white outline-none focus:border-indigo-500 focus:ring-2 focus:ring-indigo-500/30"
					>{initial.excerpt}</textarea>
				</div>
			</div>

			<aside class="space-y-4">
				<div class="rounded-xl border border-slate-800 bg-slate-900/60 p-4">
					<h3 class="text-sm font-semibold text-slate-200">Xuất bản</h3>
					<select
						id="status"
						name="status"
						class="mt-3 w-full rounded-lg border border-slate-700 bg-slate-800 px-3 py-2 text-white outline-none focus:border-indigo-500"
					>
						<option value="draft" selected={initial.status === 'draft'}>Draft</option>
						<option value="published" selected={initial.status === 'published'}>
							Published
						</option>
						<option value="archived" selected={initial.status === 'archived'}>
							Archived
						</option>
					</select>
				</div>

				<div class="rounded-xl border border-slate-800 bg-slate-900/60 p-4">
					<h3 class="text-sm font-semibold text-slate-200">Ảnh đại diện</h3>
					<input
						id="featured_image"
						name="featured_image"
						type="url"
						value={initial.featuredImage}
						class="mt-2 w-full rounded-lg border border-slate-700 bg-slate-800 px-3 py-2 text-xs text-slate-400 outline-none focus:border-indigo-500"
						placeholder="URL ảnh (tự điền sau upload)"
						readonly
					/>
					<div class="mt-3">
						<ImageUploader
							targetInputId="featured_image"
							initialUrl={initial.featuredImage}
							compact
						/>
					</div>
				</div>

				<div class="rounded-xl border border-slate-800 bg-slate-900/60 p-4">
					<h3 class="text-sm font-semibold text-slate-200">Categories</h3>
					<ul class="mt-3 max-h-36 space-y-2 overflow-y-auto">
						{
							categories.length === 0 ? (
								<li class="text-sm text-slate-500">
									<a href="/admin/categories" class="text-indigo-400 hover:underline">
										Tạo category
									</a>
								</li>
							) : (
								categories.map((cat) => (
									<li>
										<label class="flex cursor-pointer items-center gap-2 text-sm text-slate-300">
											<input
												type="checkbox"
												name="category_ids"
												value={cat.id}
												checked={initial.categoryIds.includes(cat.id)}
												class="rounded border-slate-600 bg-slate-800 text-indigo-500"
											/>
											{escapeHtml(cat.name)}
										</label>
									</li>
								))
							)
						}
					</ul>
				</div>

				<div class="rounded-xl border border-slate-800 bg-slate-900/60 p-4">
					<h3 class="text-sm font-semibold text-slate-200">Tags</h3>
					<ul class="mt-3 max-h-36 space-y-2 overflow-y-auto">
						{
							tags.length === 0 ? (
								<li class="text-sm text-slate-500">
									<a href="/admin/tags" class="text-indigo-400 hover:underline">
										Tạo tag
									</a>
								</li>
							) : (
								tags.map((tag) => (
									<li>
										<label class="flex cursor-pointer items-center gap-2 text-sm text-slate-300">
											<input
												type="checkbox"
												name="tag_ids"
												value={tag.id}
												checked={initial.tagIds.includes(tag.id)}
												class="rounded border-slate-600 bg-slate-800 text-indigo-500"
											/>
											{escapeHtml(tag.name)}
										</label>
									</li>
								))
							)
						}
					</ul>
				</div>
			</aside>
		</div>

		<div
			id="form-message"
			class="hidden rounded-lg border px-4 py-3 text-sm"
			role="alert"
		>
		</div>

		<div class="flex flex-wrap gap-3 border-t border-slate-800 pt-6">
			<button
				type="submit"
				id="submit-btn"
				data-loading-text="Đang lưu..."
				data-label={isEdit ? 'Cập nhật bài viết' : 'Tạo bài viết'}
				class="rounded-lg bg-indigo-600 px-5 py-2.5 text-sm font-semibold text-white shadow-lg shadow-indigo-900/30 transition hover:bg-indigo-500 disabled:opacity-50"
			>
				{isEdit ? 'Cập nhật bài viết' : 'Tạo bài viết'}
			</button>
			<a
				href="/admin/posts"
				class="rounded-lg border border-slate-700 px-5 py-2.5 text-sm text-slate-300 transition hover:bg-slate-800"
			>
				Hủy
			</a>
		</div>
	</form>
</div>

<script define:vars={{ mode, postId }}>
	import { initPostForm } from '../../scripts/post-form';
	initPostForm({ mode, postId });
</script>
