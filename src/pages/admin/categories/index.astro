---
/**
 * CRUD Categories — giao diện admin.
 */
import AuthGuard from '../../../components/AuthGuard.astro';
import TaxonomyCrud from '../../../components/admin/TaxonomyCrud.astro';
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { getAllCategories } from '../../../lib/db/categories';
import { getDb } from '../../../lib/db';

export const prerender = false;

const db = getDb();
const items = await getAllCategories(db);
---

<AuthGuard role="admin">
	<AdminLayout title="Categories" description="Quản lý chuyên mục bài viết">
		<TaxonomyCrud type="categories" items={items} />
	</AdminLayout>
</AuthGuard>
