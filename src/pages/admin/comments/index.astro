---
/**
 * Quản lý bình luận — pending, approve/spam/delete.
 */
import AuthGuard from '../../../components/AuthGuard.astro';
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { countPendingComments, getCommentsByStatus } from '../../../lib/db/comments';
import { getDb } from '../../../lib/db';
import { escapeHtml } from '../../../lib/security';
import type { CommentStatus } from '../../../../db/schema';

export const prerender = false;

const user = Astro.locals.user!;
const isAdmin = user.role === 'admin';
const db = getDb();

const statusParam = Astro.url.searchParams.get('status');
const statusFilter: CommentStatus =
	statusParam === 'approved' || statusParam === 'spam' || statusParam === 'pending'
		? statusParam
		: 'pending';

const page = Math.max(1, Number(Astro.url.searchParams.get('page') ?? '1') || 1);
const limit = 20;

const [{ items, pagination }, pendingTotal] = await Promise.all([
	getCommentsByStatus(db, statusFilter, page, limit),
	countPendingComments(db),
]);

function formatDate(iso: string): string {
	try {
		return new Date(iso).toLocaleString('vi-VN', {
			day: '2-digit',
			month: '2-digit',
			year: 'numeric',
			hour: '2-digit',
			minute: '2-digit',
		});
	} catch {
		return '—';
	}
}

function tabUrl(status: CommentStatus, p = 1): string {
	const params = new URLSearchParams({ status });
	if (p > 1) params.set('page', String(p));
	return `/admin/comments?${params}`;
}

function statusBadgeClass(status: CommentStatus): string {
	const map: Record<CommentStatus, string> = {
		pending: 'bg-amber-500/15 text-amber-300 ring-amber-500/30',
		approved: 'bg-emerald-500/15 text-emerald-300 ring-emerald-500/30',
		spam: 'bg-red-500/15 text-red-300 ring-red-500/30',
		trashed: 'bg-slate-500/15 text-slate-400 ring-slate-500/30',
	};
	return map[status];
}
---

<AuthGuard role="editor">
	<AdminLayout
		title="Bình luận"
		description={`${pendingTotal} bình luận chờ duyệt`}
	>
		<div class="mb-6 flex flex-wrap items-center justify-between gap-4">
			<div class="flex flex-wrap gap-2">
				<a
					href={tabUrl('pending')}
					class:list={[
						'rounded-lg px-3 py-1.5 text-sm font-medium transition',
						statusFilter === 'pending'
							? 'bg-indigo-600 text-white'
							: 'border border-slate-700 text-slate-400 hover:bg-slate-800',
					]}
				>
					Chờ duyệt
					{
						pendingTotal > 0 && (
							<span
								id="pending-badge"
								class="ml-1.5 rounded-full bg-amber-500/20 px-2 py-0.5 text-xs text-amber-300"
							>
								{pendingTotal}
							</span>
						)
					}
				</a>
				<a
					href={tabUrl('approved')}
					class:list={[
						'rounded-lg px-3 py-1.5 text-sm font-medium transition',
						statusFilter === 'approved'
							? 'bg-indigo-600 text-white'
							: 'border border-slate-700 text-slate-400 hover:bg-slate-800',
					]}
				>
					Đã duyệt
				</a>
				<a
					href={tabUrl('spam')}
					class:list={[
						'rounded-lg px-3 py-1.5 text-sm font-medium transition',
						statusFilter === 'spam'
							? 'bg-indigo-600 text-white'
							: 'border border-slate-700 text-slate-400 hover:bg-slate-800',
					]}
				>
					Spam
				</a>
			</div>
		</div>

		<div class="overflow-x-auto rounded-xl border border-slate-800">
			<table class="w-full min-w-[640px] text-left text-sm">
				<thead class="border-b border-slate-800 bg-slate-900/80 text-slate-400">
					<tr>
						<th class="px-4 py-3 font-medium">Tác giả</th>
						<th class="px-4 py-3 font-medium">Bài viết</th>
						<th class="px-4 py-3 font-medium">Nội dung</th>
						<th class="px-4 py-3 font-medium">Trạng thái</th>
						<th class="px-4 py-3 font-medium">Thời gian</th>
						<th class="px-4 py-3 font-medium">Thao tác</th>
					</tr>
				</thead>
				<tbody id="comments-tbody" class="divide-y divide-slate-800">
					{
						items.map((c) => (
							<tr data-comment-id={c.id} class="bg-slate-900/40">
								<td class="px-4 py-3 align-top">
									<p class="font-medium text-slate-200">{escapeHtml(c.authorName)}</p>
									<p class="mt-0.5 text-xs text-slate-500">{escapeHtml(c.authorEmail)}</p>
								</td>
								<td class="px-4 py-3 align-top">
									<a
										href={`/posts/${c.postSlug}`}
										target="_blank"
										rel="noopener noreferrer"
										class="text-indigo-400 hover:underline"
									>
										{escapeHtml(c.postTitle)}
									</a>
								</td>
								<td class="max-w-xs px-4 py-3 align-top">
									<p class="line-clamp-3 text-slate-300">{escapeHtml(c.content)}</p>
								</td>
								<td class="px-4 py-3 align-top">
									<span
										class:list={[
											'inline-flex rounded-full px-2 py-0.5 text-xs font-medium ring-1 ring-inset',
											statusBadgeClass(c.status),
										]}
									>
										{c.status}
									</span>
								</td>
								<td class="whitespace-nowrap px-4 py-3 align-top text-slate-500">
									{formatDate(c.createdAt)}
								</td>
								<td class="px-4 py-3 align-top">
									<div class="flex flex-wrap gap-2">
										{
											c.status !== 'approved' && (
												<button
													type="button"
													data-comment-action="approve"
													data-comment-id={c.id}
													class="rounded-lg bg-emerald-600/20 px-2.5 py-1 text-xs font-medium text-emerald-300 hover:bg-emerald-600/30"
												>
													Duyệt
												</button>
											)
										}
										{
											c.status !== 'spam' && (
												<button
													type="button"
													data-comment-action="spam"
													data-comment-id={c.id}
													class="rounded-lg bg-amber-600/20 px-2.5 py-1 text-xs font-medium text-amber-300 hover:bg-amber-600/30"
												>
													Spam
												</button>
											)
										}
										{
											isAdmin && (
												<button
													type="button"
													data-comment-action="delete"
													data-comment-id={c.id}
													class="rounded-lg bg-red-600/20 px-2.5 py-1 text-xs font-medium text-red-300 hover:bg-red-600/30"
												>
													Xóa
												</button>
											)
										}
									</div>
								</td>
							</tr>
						))
					}
				</tbody>
			</table>

			<p
				id="comments-empty"
				class:list={['px-4 py-12 text-center text-slate-500', items.length > 0 && 'hidden']}
			>
				Không có bình luận trong mục này.
			</p>
		</div>

		{
			pagination.totalPages > 1 && (
				<nav class="mt-6 flex justify-center gap-2" aria-label="Phân trang">
					{
						Array.from({ length: pagination.totalPages }, (_, i) => i + 1).map((p) => (
							<a
								href={tabUrl(statusFilter, p)}
								class:list={[
									'rounded-lg px-3 py-1.5 text-sm',
									p === pagination.page
										? 'bg-indigo-600 text-white'
										: 'border border-slate-700 text-slate-400 hover:bg-slate-800',
								]}
							>
								{p}
							</a>
						))
					}
				</nav>
			)
		}

		<script define:vars={{ isAdmin }}>
			import { initCommentsAdmin } from '../../../scripts/comments-admin';
			initCommentsAdmin();
		</script>
	</AdminLayout>
</AuthGuard>
