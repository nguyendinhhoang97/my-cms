---
/**
 * Admin dashboard — thống kê + sidebar layout.
 */
import { count } from 'drizzle-orm';
import AuthGuard from '../../components/AuthGuard.astro';
import AdminLayout from '../../layouts/AdminLayout.astro';
import { posts, users } from '../../../db/schema';
import { getDb } from '../../lib/db';

export const prerender = false;

const db = getDb();

const [[postRow], [userRow]] = await Promise.all([
	db.select({ total: count() }).from(posts),
	db.select({ total: count() }).from(users),
]);

const postCount = postRow?.total ?? 0;
const userCount = userRow?.total ?? 0;
---

<AuthGuard role="admin">
	<AdminLayout title="Tổng quan" description="Thống kê nhanh từ D1">
		<div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
			<a
				href="/admin/posts"
				class="rounded-2xl border border-slate-800 bg-slate-900/60 p-6 transition hover:border-indigo-500/40 hover:bg-slate-900"
			>
				<p class="text-sm font-medium text-slate-400">Bài viết</p>
				<p class="mt-2 text-3xl font-bold text-indigo-400">{postCount}</p>
			</a>
			<article class="rounded-2xl border border-slate-800 bg-slate-900/60 p-6">
				<p class="text-sm font-medium text-slate-400">Người dùng</p>
				<p class="mt-2 text-3xl font-bold text-cyan-400">{userCount}</p>
			</article>
			<a
				href="/admin/categories"
				class="rounded-2xl border border-slate-800 bg-slate-900/60 p-6 transition hover:border-indigo-500/40"
			>
				<p class="text-sm font-medium text-slate-400">Categories</p>
				<p class="mt-2 text-sm text-indigo-400">Quản lý →</p>
			</a>
			<a
				href="/admin/tags"
				class="rounded-2xl border border-slate-800 bg-slate-900/60 p-6 transition hover:border-indigo-500/40"
			>
				<p class="text-sm font-medium text-slate-400">Tags</p>
				<p class="mt-2 text-sm text-indigo-400">Quản lý →</p>
			</a>
		</div>

		<div class="mt-8">
			<a
				href="/admin/posts/create"
				class="inline-flex rounded-lg bg-indigo-600 px-4 py-2 text-sm font-semibold text-white hover:bg-indigo-500"
			>
				+ Viết bài mới
			</a>
		</div>
	</AdminLayout>
</AuthGuard>
