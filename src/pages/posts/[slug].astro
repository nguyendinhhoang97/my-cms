---
/**
 * Chi tiết bài viết theo slug.
 */
import BlogLayout from '../../layouts/BlogLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import JsonLd from '../../components/JsonLd.astro';
import CommentSection from '../../components/CommentSection.astro';
import RelatedPosts from '../../components/RelatedPosts.astro';
import SocialShare from '../../components/SocialShare.astro';
import TableOfContents from '../../components/TableOfContents.astro';
import { getApprovedCommentsByPostId } from '../../lib/db/comments';
import { getDb } from '../../lib/db';
import { getRelatedPosts } from '../../lib/db/relatedPosts';
import { getPublishedPostBySlug } from '../../lib/db/posts';
import { formatBlogDate, renderMarkdownWithToc } from '../../lib/markdown';
import { readingTime } from '../../lib/utils/readingTime';
import { absoluteUrl, truncateDescription } from '../../lib/seo/config';
import { escapeHtml } from '../../lib/security';

export const prerender = false;

const slug = Astro.params.slug ?? '';
const origin = Astro.url.origin;
const db = getDb();

const post = await getPublishedPostBySlug(db, slug);
if (!post) {
	return Astro.redirect('/');
}

const [comments, related] = await Promise.all([
	getApprovedCommentsByPostId(db, post.id),
	getRelatedPosts(db, post.id, 3),
]);

const { html: contentHtml, headings } = renderMarkdownWithToc(post.content);
const readTimeLabel = readingTime(post.content);
const publishedDate = formatBlogDate(post.publishedAt);
const pageUrl = absoluteUrl(origin, `/posts/${post.slug}`);
const csrfToken = Astro.locals.csrfToken;
const imageAlt = `Ảnh đại diện: ${post.title}`;

const breadcrumbItems = [
	{ label: 'Home', href: '/' },
	...(post.categories[0]
		? [{ label: post.categories[0].name, href: `/categories/${post.categories[0].slug}` }]
		: []),
	{ label: post.title },
];

const seoKeywords = [
	...post.categories.map((c) => c.name),
	...post.tags.map((t) => t.name),
];
---

<BlogLayout
	title={post.title}
	description={truncateDescription(post.excerpt ?? post.content.replace(/[#*`]/g, ' '))}
	image={post.featuredImage}
	url={pageUrl}
	type="article"
	keywords={seoKeywords}
	publishedTime={post.publishedAt}
>
	<JsonLd slot="jsonld" kind="blogPosting" origin={origin} post={post} />
	<JsonLd slot="jsonld" kind="breadcrumbList" origin={origin} items={breadcrumbItems} />

	<Breadcrumb items={breadcrumbItems} />

	<article>
		<header class="mb-8">
			<h1 class="text-3xl font-bold leading-tight sm:text-4xl">{escapeHtml(post.title)}</h1>
			<div class="mt-4 flex flex-wrap items-center gap-3 text-sm opacity-60">
				{publishedDate && <time datetime={post.publishedAt ?? ''}>{publishedDate}</time>}
				<span aria-hidden="true">·</span>
				<span>{readTimeLabel}</span>
				<span aria-hidden="true">·</span>
				<span>
					<span id="view-count">{post.viewCount}</span> lượt xem
				</span>
			</div>
			{
				post.categories.length > 0 && (
					<div class="mt-4 flex flex-wrap gap-2">
						{post.categories.map((cat) => (
							<a
								href={`/categories/${cat.slug}`}
								class="rounded-full bg-indigo-500/10 px-3 py-1 text-xs font-medium text-indigo-600 dark:text-indigo-300"
							>
								{escapeHtml(cat.name)}
							</a>
						))}
					</div>
				)
			}
		</header>

		{
			post.featuredImage && (
				<img
					src={post.featuredImage}
					alt={imageAlt}
					class="mb-8 w-full rounded-2xl object-cover shadow-lg"
					loading="eager"
					decoding="async"
				/>
			)
		}

		<div class="blog-prose lg:hidden">
			<TableOfContents headings={headings} />
		</div>

		<div class="lg:grid lg:grid-cols-[1fr_240px] lg:gap-10">
			<div class="blog-prose min-w-0" set:html={contentHtml} />
			<div class="hidden lg:block">
				<TableOfContents headings={headings} />
			</div>
		</div>

		{
			post.tags.length > 0 && (
				<div class="mt-8 flex flex-wrap gap-2 border-t border-slate-200 pt-6 dark:border-slate-800">
					{post.tags.map((tag) => (
						<a
							href={`/tags/${tag.slug}`}
							class="rounded-lg border border-slate-200 px-3 py-1 text-xs dark:border-slate-700"
						>
							#{escapeHtml(tag.name)}
						</a>
					))}
				</div>
			)
		}

		<div class="mt-8 border-t border-slate-200 pt-6 dark:border-slate-800">
			<SocialShare url={pageUrl} title={post.title} />
		</div>
	</article>

	<RelatedPosts posts={related} />

	<CommentSection postId={post.id} comments={comments} csrfToken={csrfToken} />
</BlogLayout>

<script define:vars={{ postId: post.id }}>
	import { trackPostView } from '../../scripts/post-view';
	trackPostView(postId);
</script>
